<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>5 Human-Centred AI Principles — Interactive</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Arial, sans-serif; background: #ffffff; color: #2C2C2A; padding: 32px 24px; max-width: 900px; margin: 0 auto; }

    .page-title { text-align: center; font-size: 11px; font-weight: 600; color: #888780; margin-bottom: 6px; letter-spacing: 0.06em; text-transform: uppercase; }
    .page-heading { text-align: center; font-size: 22px; font-weight: 700; color: #26215C; margin-bottom: 4px; }
    .subtitle { font-size: 12px; color: #888780; text-align: center; margin-bottom: 22px; }

    .grid { display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); gap: 10px; margin-bottom: 20px; }
    .pill { border-radius: 10px; padding: 14px 8px; cursor: pointer; border: 2px solid transparent; transition: border-color 0.15s, opacity 0.15s; text-align: center; user-select: none; }
    .pill:hover { opacity: 0.82; }
    .pill.active { border-color: #444441; }
    .pill-tag { font-size: 18px; font-weight: 700; margin-bottom: 4px; }
    .pill-name { font-size: 10px; font-weight: 600; line-height: 1.4; }

    .detail { border-radius: 12px; border: 1px solid #e0e0d8; overflow: hidden; }
    .detail-header { display: flex; align-items: center; gap: 16px; padding: 18px 20px; }
    .detail-badge { width: 60px; height: 60px; border-radius: 10px; display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; }
    .detail-badge-tag { font-size: 20px; font-weight: 700; }
    .detail-badge-name { font-size: 9px; font-weight: 600; text-align: center; line-height: 1.3; }
    .detail-heading { font-size: 17px; font-weight: 700; color: #2C2C2A; margin-bottom: 3px; }
    .detail-sub { font-size: 12px; color: #888780; }

    .detail-body { padding: 0 20px 20px; background: #fafaf8; }
    .section-label { font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #888780; padding-top: 16px; margin-bottom: 7px; }
    .def-text { font-size: 13px; color: #2C2C2A; line-height: 1.75; margin-bottom: 14px; }
    .why-text { font-size: 12px; color: #5F5E5A; line-height: 1.72; margin-bottom: 16px; }

    .classroom-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .classroom-card { padding: 12px 14px; border-radius: 8px; border: 1px solid #e8e8e0; background: #ffffff; }
    .classroom-card-label { font-size: 10px; font-weight: 700; margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.05em; }
    .classroom-card-text { font-size: 12px; color: #5F5E5A; line-height: 1.6; }

    .nav { display: flex; justify-content: center; gap: 10px; margin-top: 16px; }
    .nav-btn { padding: 7px 20px; border-radius: 7px; border: 1px solid #d3d1c7; background: #f1efea; color: #5F5E5A; font-size: 12px; font-family: Arial, sans-serif; cursor: pointer; transition: background 0.12s; }
    .nav-btn:hover { background: #e8e6e1; }

    .source { font-size: 11px; color: #888780; text-align: center; margin-top: 16px; font-style: italic; }

    @media (max-width: 600px) {
      .grid { grid-template-columns: repeat(3, minmax(0,1fr)); }
      .classroom-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<div class="page-title">Foundations of AI — Preservice Teacher Education</div>
<div class="page-heading">Human-centred AI principles</div>
<div class="subtitle">Click any principle to explore its definition, rationale, and classroom application</div>

<div class="grid" id="pill-grid"></div>
<div class="detail" id="detail-panel"></div>

<div class="nav">
  <button class="nav-btn" onclick="prev()">← Previous</button>
  <button class="nav-btn" onclick="next()">Next →</button>
</div>

<div class="source">Based on UNESCO AI Competency Framework for Teachers (2024) &amp; Selwyn (2024) on AI deskilling in education</div>

<script>
const principles = [
  {
    tag: "P1",
    name: "Human agency & oversight",
    badgeBg: "#534AB7", badgeText: "#EEEDFE", lightBg: "#EEEDFE",
    accentText: "#3C3489", doColor: "#534AB7", avoidColor: "#D85A30",
    definition: "AI should support human decision-making, not replace it. Teachers and students retain the authority to question, override, and take responsibility for AI outputs.",
    why: "Teachers are professionals with ethical obligations. When AI automates decisions — about grades, groupings, or communications — it removes the professional judgment that is central to teaching. Agency means the teacher is always the decision-maker; AI is always the tool.",
    doText: "Review every AI-generated recommendation before acting on it. Be able to explain any AI-assisted decision to students and parents in your own words.",
    avoidText: "Accept AI outputs as final without reading them. Allow AI to communicate directly with students or parents without your review."
  },
  {
    tag: "P2",
    name: "Fairness & equity",
    badgeBg: "#0F6E56", badgeText: "#E1F5EE", lightBg: "#E1F5EE",
    accentText: "#085041", doColor: "#0F6E56", avoidColor: "#D85A30",
    definition: "AI systems must be designed and used in ways that reduce, not amplify, existing inequalities. This includes attention to who the AI was trained on and who it may disadvantage.",
    why: "AI learns from historical data that reflects historical inequalities. If training data underrepresents certain student groups — by language, culture, disability, or socioeconomic background — the AI will perform less fairly for those students.",
    doText: "Test AI tools with diverse student samples before adopting them. Ask the provider: who was this tool trained on? Does it perform equally across languages and cultures?",
    avoidText: "Apply AI-generated scores or feedback directly to grades without reviewing whether the tool works equitably for all your students."
  },
  {
    tag: "P3",
    name: "Transparency & explainability",
    badgeBg: "#185FA5", badgeText: "#E6F1FB", lightBg: "#E6F1FB",
    accentText: "#0C447C", doColor: "#185FA5", avoidColor: "#D85A30",
    definition: "Teachers and students should be able to understand, in accessible terms, how an AI system reaches its outputs. \"The AI decided\" is not an acceptable professional explanation.",
    why: "If a teacher cannot explain why a student received a particular AI-generated grade or recommendation, they cannot exercise professional judgment about whether it is correct. Transparency also means students have the right to understand how AI is being used in their education.",
    doText: "Only use AI tools whose outputs you can read, interpret, and explain. Be transparent with students about when and how AI is used in their assessment or learning.",
    avoidText: "Use AI tools that only produce scores or categories without showing the reasoning. Accept a grade or recommendation you cannot explain to the student."
  },
  {
    tag: "P4",
    name: "Well-being & inclusivity",
    badgeBg: "#854F0B", badgeText: "#FAEEDA", lightBg: "#FAEEDA",
    accentText: "#633806", doColor: "#854F0B", avoidColor: "#D85A30",
    definition: "AI tools should respect and support the whole person — emotional, cultural, and individual. AI must not reduce students to data points or expose them to harm.",
    why: "Education is fundamentally relational. AI that monitors student behaviour, generates feedback without context, or applies content that ignores cultural identity can undermine the psychological safety and sense of belonging that effective learning requires.",
    doText: "Inform students and parents about any data collected about them. Evaluate whether AI tools respect cultural diversity and emotional safety before using them in your classroom.",
    avoidText: "Deploy monitoring or tracking tools without student and parent knowledge. Use AI tools that flag students by behaviour patterns without teacher interpretation and context."
  },
  {
    tag: "P5",
    name: "Preserve cognitive capacities",
    badgeBg: "#3B6D11", badgeText: "#EAF3DE", lightBg: "#EAF3DE",
    accentText: "#27500A", doColor: "#3B6D11", avoidColor: "#D85A30",
    definition: "Teachers must actively protect and cultivate the metacognitive, critical thinking, and creative capacities in both themselves and their students that AI risks eroding through over-reliance.",
    why: "AI should be used to augment human cognitive capacities, never to replace the cognitive effort that develops them. When AI does the thinking, reflecting, and creating for students, the skills that define deep learning are never built.",
    doText: "Require students to think, plan, or draft first — before any AI involvement. Design tasks where AI is a thinking partner, not a replacement for thinking.",
    avoidText: "Accept AI-generated work as the student's own without requiring them to explain, justify, or extend it. Use AI to plan lessons you cannot explain the rationale behind."
  }
];

let active = 0;

function renderPills() {
  document.getElementById('pill-grid').innerHTML = principles.map((p, i) => `
    <div class="pill ${i === active ? 'active' : ''}"
         style="background:${p.lightBg}; cursor:pointer;"
         onclick="select(${i})">
      <div class="pill-tag" style="color:${p.badgeBg};">${p.tag}</div>
      <div class="pill-name" style="color:${p.accentText};">${p.name}</div>
    </div>
  `).join('');
}

function renderDetail() {
  const p = principles[active];
  document.getElementById('detail-panel').innerHTML = `
    <div class="detail-header" style="background:${p.lightBg};">
      <div class="detail-badge" style="background:${p.badgeBg};">
        <div class="detail-badge-tag" style="color:${p.badgeText};">${p.tag}</div>
        <div class="detail-badge-name" style="color:${p.badgeText};">${p.name}</div>
      </div>
      <div>
        <div class="detail-heading">${p.name}</div>
        <div class="detail-sub">Human-centred principle ${active + 1} of 5</div>
      </div>
    </div>
    <div class="detail-body">
      <div class="section-label">Definition</div>
      <div class="def-text">${p.definition}</div>
      <div class="section-label">Why it matters in education</div>
      <div class="why-text">${p.why}</div>
      <div class="section-label">In the classroom</div>
      <div class="classroom-grid">
        <div class="classroom-card">
          <div class="classroom-card-label" style="color:${p.doColor};">Do</div>
          <div class="classroom-card-text">${p.doText}</div>
        </div>
        <div class="classroom-card">
          <div class="classroom-card-label" style="color:${p.avoidColor};">Avoid</div>
          <div class="classroom-card-text">${p.avoidText}</div>
        </div>
      </div>
    </div>
  `;
}

function select(i) { active = i; renderPills(); renderDetail(); }
function next() { select((active + 1) % principles.length); }
function prev() { select((active + 4) % principles.length); }

renderPills();
renderDetail();
</script>

</body>
</html>
